<?xml version="1.0" encoding='UTF-8'?>
<odoo>
    <record id="view_production_lot_form_inherit_kloudip_stock" model="ir.ui.view">
        <field name="name">stock.production.lot.form.inherit.kloudip.stock</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="is_manager" invisible="not is_manager"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="readonly">not is_manager</attribute>
            </xpath>
        </field>
    </record>

