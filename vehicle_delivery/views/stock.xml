<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Operations tab inline tree (e.g. inside stock.move form) -->
        <record model="ir.ui.view" id="stock_move_line_tree_view_inherited_kloudip">
            <field name="name">stock.move.line.tree.inherit.vehicle_delivery</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='lot_id']" position="after">
                    <field name="x_partner_id" column_invisible="1"/>
                    <field name="x_vehicle_id"
                           readonly="not lot_id"
                           domain="[('driver_id', 'child_of', x_partner_id)]"
                           groups="stock.group_production_lot"/>
                </xpath>
                <xpath expr="//field[@name='lot_id']" position="attributes">
                    <attribute name="column_invisible">parent.show_lots_text</attribute>
                    <attribute name="readonly">state in ('done', 'cancel') and is_locked</attribute>
                    <attribute name="force_save">1</attribute>
                </xpath>
            </field>
        </record>

        <!-- Move line form view -->
        <record model="ir.ui.view" id="stock_move_line_form_view_inherited_kloudip">
            <field name="name">stock.move.line.form.inherit.vehicle_delivery</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_move_line_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='lot_id']" position="after">
                    <!-- Use invisible (not column_invisible) in form views -->
                    <field name="x_partner_id" invisible="1"/>
                    <field name="x_vehicle_id"
                           readonly="not lot_id"
                           domain="[('driver_id', 'child_of', x_partner_id)]"
                           groups="stock.group_production_lot"/>
                </xpath>
            </field>
        </record>

        <!-- Detailed Operations tab tree (stock.picking form → Detailed Operations page) -->
        <record model="ir.ui.view" id="stock_picking_view_inherited_kloudip">
            <field name="name">stock.move.line.detailed.tree.inherit.vehicle_delivery</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='lot_id']" position="after">
                    <field name="x_partner_id" column_invisible="1"/>
                    <field name="x_vehicle_id"
                           readonly="not lot_id"
                           domain="[('driver_id', 'child_of', x_partner_id)]"
                           groups="stock.group_production_lot"/>
                </xpath>

                <xpath expr="//field[@name='lot_id']" position="attributes">
                    <attribute name="column_invisible">context.get('show_lots_text')</attribute>
                    <attribute name="readonly">context.get('picking_code') != 'incoming' or (state in ('done', 'cancel') and is_locked)</attribute>
                    <attribute name="optional"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>