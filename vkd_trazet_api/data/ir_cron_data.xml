<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ir_cron__update_trazet_next_invoice_dates" model="ir.cron">
            <field name="name">Update Trazet Effective Dates (with Grace Periods)</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model.cron_update_trazet_effective_dates()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_api_retry_failed_calls" model="ir.cron">
            <field name="name">Retry Failed API Calls</field>
            <field name="model_id" ref="vkd_trazet_api.model_api_retry_log"/>
            <field name="state">code</field>
            <field name="code">model.cron_retry_failed_api_calls()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>