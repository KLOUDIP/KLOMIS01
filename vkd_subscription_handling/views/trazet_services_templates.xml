<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_trazet_services" name="Trazet Services" customize_show="True"
              inherit_id="portal.portal_my_home" priority="91">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <!-- Enables the #portal_client_category container in portal.portal_my_home.
                 That div is rendered behind t-if="portal_client_category_enable", so
                 without this exact flag the card below is added to an element that
                 never renders and disappears silently. -->
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Trazet Services</t>
                <t t-set="text">View your Trazet product usage</t>
                <t t-set="url" t-value="'/my/services'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </div>
    </template>

    <template id="portal_my_trazet_services" name="My Trazet Services">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Services</t>
            </t>

            <div class="alert alert-danger alert-dismissible" t-if="grace_error">
                <span t-out="grace_error"/>
                <button type="button" class="btn-close" data-bs-dismiss="alert"/>
            </div>
            <div class="alert alert-success alert-dismissible" t-if="grace_message">
                <span t-out="grace_message"/>
                <button type="button" class="btn-close" data-bs-dismiss="alert"/>
            </div>

            <t t-if="not services">
                <p class="alert alert-warning">You don't have any active Trazet services yet.</p>
            </t>
            <t t-else="">
                <div class="row g-3">
                    <t t-foreach="services" t-as="service">
                        <div class="col-md-4">
                            <div class="border rounded p-3 h-100 d-flex align-items-center gap-3">
                                <i t-attf-class="fa #{service['icon']} fa-2x text-primary"/>
                                <div>
                                    <div class="text-muted small">
                                        <t t-out="service['label']"/>
                                    </div>
                                    <div class="fs-5 fw-bold">
                                        <t t-out="service['value']"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </t>

            <!-- Grace period. The same allowance the billing team grants from the
                 subscription form: whichever side uses it first closes the other,
                 so this block only ever shows one of offer / already-used. -->
            <t t-if="grace_eligible">
                <h5 class="mt-4">Payment grace period</h5>
                <div class="border rounded p-3">
                    <t t-if="grace_available">
                        <p class="mb-2">
                            Need a little more time to pay? You can keep your Trazet
                            services running for
                            <strong><t t-out="grace_days"/> more days</strong>
                            past your next invoice date. This can be used
                            <strong>once per billing cycle</strong>, and asking here is
                            the same request as asking our billing team.
                        </p>
                        <form action="/my/services/grace" method="post">
                            <input type="hidden" name="csrf_token"
                                   t-att-value="request.csrf_token()"/>
                            <button type="submit" class="btn btn-primary">
                                Activate my <t t-out="grace_days"/>-day grace period
                            </button>
                        </form>
                    </t>
                    <t t-elif="grace_used">
                        <p class="mb-0">
                            You have already used your <t t-out="grace_used_days"/>-day
                            grace period for this billing cycle<t t-if="grace_used_on">
                            (activated on <t t-out="grace_used_on"
                                             t-options="{'widget': 'date'}"/>)</t><t
                                t-if="grace_used_source == 'backend'"> by our billing
                            team</t>.
                            <t t-if="grace_expiry">
                                Your services stay on until
                                <strong t-out="grace_expiry"
                                        t-options="{'widget': 'date'}"/>.
                            </t>
                            It becomes available again on your next invoice date.
                        </p>
                    </t>
                    <t t-else="">
                        <p class="mb-0 text-muted">
                            The grace period is not available online at the moment.
                            Please contact support if you need more time to pay.
                        </p>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>