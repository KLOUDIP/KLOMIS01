<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_lk">

        <!--
            The v17 rules that used to live here -

                .address.row              { display: none !important; }
                div[name="address"]       { display: none !important; }
                div[name="information_block"] { display: none !important; }
                div[name="company_address"]   { display: none !important; }

            - no longer match anything in Odoo 19. `address` and
            `information_block` stopped being divs with those names and became
            QWeb variables set with <t t-set="..."> inside
            account.report_invoice_document, which web.external_layout then
            renders through web.address_layout. They are now blanked in the
            inheriting template below, which is both simpler and no longer tied
            to core's markup.
        -->

        <div class="page lk-invoice">

            <div class="text-center" style="padding-top: 20px; padding-bottom: 15px;">
                <h2 style="border: 2px solid black; display: inline-block; padding: 10px 30px; margin: 0;">
                    <span t-if="o.move_type == 'out_invoice'">Tax Invoice</span>
                    <span t-if="o.move_type == 'out_refund'">Tax Credit Note</span>
                </h2>
            </div>

            <div class="row">
                <div class="col-6">
                    <div class="lk-box-left">
                        <span>Date of Invoice:</span>
                        <span t-esc="o.invoice_date.strftime('%m/%d/%Y') if o.invoice_date else ''"/>
                    </div>
                </div>
                <div class="col-6">
                    <div class="lk-box-right">
                        <span t-if="o.move_type == 'out_invoice'">Tax Invoice No.:</span>
                        <span t-if="o.move_type == 'out_refund'">Tax Credit Note No.:</span>

                        <!--
                            `o.state == 'posted'` was dropped: it added nothing
                            (an unposted move has no real name, which the checks
                            below already cover) and it silently sent every
                            preview / proforma / non-posted render down the else
                            branch, printing the raw sequence "26/08_KLRV_00379"
                            instead of the formatted "26AUG_KLRV_00379".
                        -->
                        <t t-if="o.invoice_date and o.name and o.name != '/'">
                            <t t-set="yy" t-value="o.invoice_date.strftime('%y')"/>
                            <t t-set="mmm" t-value="o.invoice_date.strftime('%b').upper()"/>
                            <t t-set="qqqq" t-value="o.journal_id.code"/>

                            <t t-set="clean_name"
                               t-value="o.name.replace('/', '_').replace('-', '_').replace(' ', '_')"/>
                            <t t-set="num_parts" t-value="[p for p in clean_name.split('_') if p.isdigit()]"/>
                            <t t-set="xxxxx" t-value="num_parts[-1] if num_parts else o.name"/>

                            <span t-out="yy + mmm + '_' + qqqq + '_' + xxxxx"/>
                        </t>
                        <t t-else="">
                            <span t-field="o.name"/>
                        </t>
                    </div>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-6">
                    <div class="lk-box-left" style="height: 250px;">
                        <div>
                            <span>Supplier's TIN:</span>
                            <span t-field="o.company_id.vat"/>
                        </div>
                        <div>
                            <span>Supplier's Name:</span>
                            <span t-field="o.company_id.name"/>
                        </div>
                        <div>
                            <span>Address:</span>
                        </div>
                        <div t-field="o.company_id.partner_id"
                             t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                        <br/>
                        <div>
                            <span>Telephone No:</span>
                            <span t-field="o.company_id.phone"/>
                        </div>
                    </div>
                </div>

                <div class="col-6">
                    <div class="lk-box-right" style="height: 250px;">
                        <div>
                            <span>Purchaser's TIN:</span>
                            <span t-field="o.partner_id.vat"/>
                        </div>
                        <div>
                            <span>Purchaser's Name:</span>
                            <t t-if="o.partner_id.parent_id"><span t-field="o.partner_id.parent_id.name"/>,
                            </t>
                            <t t-if="o.partner_id.company_name"><span t-field="o.partner_id.company_name"/>,
                            </t>
                            <span t-field="o.partner_id.name"/>
                        </div>
                        <div>
                            <span>Address:</span>
                        </div>
                        <div t-field="o.partner_id"
                             t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                        <br/>
                        <div>
                            <span>Telephone No:</span>
                            <span t-field="o.partner_id.phone"/>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-6">
                    <div class="lk-box-left">
                        <span>Date of Delivery:</span>
                        <span t-esc="o.delivery_date.strftime('%m/%d/%Y') if o.delivery_date else ''"/>
                    </div>
                </div>
                <div class="col-6">
                    <div class="lk-box-right">
                        <span>Place of Supply:</span>
                        <span t-field="o.partner_shipping_id"
                              t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                    </div>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-12">
                    <div class="lk-box" style="height: 60px;">
                        <span>Additional Information if any:</span>
                        <span t-field="o.additional_info"/>
                    </div>
                </div>
            </div>

            <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>
            <table class="lk-table mt-4 w-100">
                <thead style="display:table-row-group">
                    <tr>
                        <th style="width: 15%;">
                            <span>Reference</span>
                        </th>
                        <th style="width: 35%;">
                            <span>Description of Goods or Services</span>
                        </th>
                        <th style="width: 10%;">
                            <span>Quantity</span>
                        </th>
                        <th style="width: 10%;">
                            <span>Unit Price</span>
                        </th>
                        <th name="th_discount" t-if="display_discount" style="width: 10%;">
                            <span>Disc.%</span>
                        </th>
                        <th style="width: 20%;">
                            <span>Amount Excluding VAT (Rs.)</span>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="total_colspan" t-value="5 if display_discount else 4"/>
                    <t t-set="lines"
                       t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>
                    <t t-foreach="lines" t-as="line">
                        <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                            <t t-if="line.display_type == 'product'" name="account_invoice_line_accountable">
                                <td>
                                    <span t-field="line.product_id.default_code"/>
                                </td>
                                <td>
                                    <span t-field="line.name"/>
                                </td>
                                <td class="text-right">
                                    <span t-field="line.quantity"/>
                                </td>
                                <td class="text-right">
                                    <span t-field="line.price_unit"/>
                                </td>
                                <td name="td_discount" t-if="display_discount">
                                    <span class="text-nowrap" t-field="line.discount"/>
                                </td>
                                <td class="text-right">
                                    <span t-field="line.price_subtotal"/>
                                </td>
                            </t>
                            <t t-elif="line.display_type == 'line_section'">
                                <td colspan="99">
                                    <span t-field="line.name" t-options="{'widget': 'text'}">A section title</span>
                                </td>
                                <t t-set="current_section" t-value="line"/>
                                <t t-set="current_subtotal" t-value="0"/>
                            </t>
                            <t t-elif="line.display_type == 'line_note'">
                                <td colspan="99">
                                    <span t-field="line.name" t-options="{'widget': 'text'}">A note</span>
                                </td>
                            </t>
                        </tr>
                    </t>
                    <tr>
                        <td t-att-colspan="total_colspan">
                            <span>Total Value of Supply:</span>
                        </td>
                        <td class="text-right">
                            <span t-field="o.amount_untaxed"/>
                        </td>
                    </tr>
                    <t t-foreach="o.get_tax_breakdown_list()" t-as="tax">
                        <tr>
                            <td t-att-colspan="total_colspan">
                                <span t-esc="tax['name']"/>
                            </td>
                            <td class="text-right">
                                <span t-esc="tax['formatted_amount']"/>
                            </td>
                        </tr>
                    </t>
                    <tr>
                        <td t-att-colspan="total_colspan">
                            <span>Total Amount including VAT:</span>
                        </td>
                        <td class="text-right">
                            <span t-field="o.amount_total"/>
                        </td>
                    </tr>
                    <t t-if="print_with_payments and o.payment_state != 'invoicing_legacy'">
                        <t t-set="payments_vals"
                           t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or []"/>
                        <t t-foreach="payments_vals" t-as="payment_vals">
                            <tr t-if="payment_vals['is_exchange'] == 0">
                                <td t-att-colspan="total_colspan">
                                    <span>Paid on</span>
                                    <span t-out="payment_vals['date']" t-options='{"widget": "date"}'/>
                                </td>
                                <td class="text-right">
                                    <span t-out="payment_vals['amount']"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </t>
                        <tr t-if="len(payments_vals) > 0">
                            <td t-att-colspan="total_colspan">
                                <span>Amount Due (Rs.):</span>
                            </td>
                            <td class="text-right">
                                <span t-field="o.amount_residual"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>

            <div class="row mt-3">
                <div class="col-12">
                    <div class="lk-box">
                        <span>Total Amount in words:</span>
                        <span t-esc="o.currency_id.amount_to_text(o.amount_total)"/>
                    </div>
                    <div class="lk-box" t-if="o.move_type == 'out_invoice'">
                        <span>Payment Terms:</span>
                        <span t-field="o.invoice_payment_term_id.name"/>
                    </div>
                    <div class="lk-box">
                        <span>Mode of Payment:</span>
                        <span t-field="o.payment_method_id.name"/>
                    </div>
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-12">
                    <t t-if="o.move_type == 'out_refund' and o.reversed_entry_id">
                        <div class="lk-box">
                            <span>Invoice No.:</span>
                            <span t-field="o.reversed_entry_id.name"/>
                        </div>
                    </t>
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-12">
                    <span t-field="o.narration"/>
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-12">
                    <span style="padding-top: 5px; display: block;">
                        This is a computer generated document and no signature is required.
                    </span>
                </div>
            </div>
        </div>
    </template>

    <template id="report_invoice_document_inherit_lk" inherit_id="account.report_invoice_document">

        <xpath expr="//div[hasclass('page')]" position="before">
            <t t-if="o.is_sri_lankan_format">
                <!--
                    Odoo 19 renders `address`, `information_block` and
                    `layout_document_title` ABOVE the report body:
                    web.external_layout_standard calls web.address_layout and
                    then outputs <h2 t-out="layout_document_title"/> before
                    <t t-out="0"/>. account.report_invoice_document fills the
                    first two with <t t-set="..."> blocks in the row that
                    precedes div.invoice_main.

                    The Sri Lankan format carries its own Supplier's / Purchaser's
                    boxes, so blank them. This runs while the t-call body is being
                    rendered - QWeb renders the body into `0` before invoking the
                    called template - so external_layout sees the blanked values.

                    This replaces the v17 approach of hiding those blocks with
                    display:none and then pulling the page up 70px to close the
                    gap. That negative margin is what pushed the "Tax Invoice" /
                    "Tax Credit Note" title box off the top of the page in v19,
                    where the header block has a different height.
                -->
                <t t-set="address" t-value="''"/>
                <t t-set="information_block" t-value="''"/>
                <t t-set="layout_document_title" t-value="''"/>
                <t t-call="vkd_lk_account_tax_report.report_invoice_document_lk"/>
            </t>
        </xpath>

        <xpath expr="//div[hasclass('page')]" position="attributes">
            <attribute name="t-if">not o.is_sri_lankan_format</attribute>
        </xpath>

    </template>
</odoo>