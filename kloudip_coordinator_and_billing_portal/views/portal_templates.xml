<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_layout_customize" inherit_id="portal.side_content">
        <xpath expr="//div[hasclass('o_portal_my_details')]" position="after">
            <div class="my-custom-section">
                <br/>
                <p>
                    <b style="color: #343A40; font-size: 1.9375rem; font-family: Bebas Neue;font-weight: 500;">SUPPORT
                        CONTACTS:
                    </b>
                    <br/>
                    Email: support@kloudip.com
                    <br/>
                    Whatsapp: +1-201 448 8116
                </p>
                <p>
                    <b style="color: #343A40; font-size: 1.9375rem; font-family: Bebas Neue; font-weight: 500;">BILLING
                        BY :
                    </b>
                    <br/>
                    <span t-field="user_id.billing_by_id"/>
                    <br/>
                    billing@kloudip.com
                </p>
            </div>
        </xpath>
    </template>

    <template id="portal_contact" inherit_id="portal.portal_contact">

        <xpath expr="//*[hasclass('fa-phone')]/.." position="before">
            <div class="d-flex flex-nowrap align-items-center mb-1">
                <div class="fa fa-mobile fa-fw me-1"></div>
                <span t-out="sales_user.sudo().partner_id.phone"/>
            </div>
        </xpath>

        <xpath expr="//*[hasclass('fa-phone')]/.." position="attributes">
            <attribute name="class" add="d-none" separator=" "/>
        </xpath>

        <xpath expr="//*[hasclass('fa-map-marker')]/.." position="attributes">
            <attribute name="class" add="d-none" separator=" "/>
        </xpath>

    </template>
</odoo>