<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_combo_view_form" model="ir.ui.view">
        <field name="name">product.combo.form</field>
        <field name="model">product.combo</field>
        <field name="inherit_id" ref="product.product_combo_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="alert alert-warning mb-0" role="alert">
                    <p>
                        When filling in the combo price, please enter the total amount for the product quantity in
                        this
                        line. For example, if the combo product's total price is $100 and this product's
                        contribution to
                        the
                        combo is for 2 units, enter the full contributing amount, not the unit price. This value
                        represents
                        how much this specific product contributes to the overall combo price.
                    </p>
                </div>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="product_quantity"/>
                <field name="combo_price"/>
                <button name="action_manage_recurring_prices"
                        type="object"
                        icon="fa-dollar"
                        string="Recurring Prices"
                        invisible="product_id.recurring_invoice == False"
                        context="{'default_combo_item_id': id}"/>
            </xpath>
        </field>
    </record>
</odoo>