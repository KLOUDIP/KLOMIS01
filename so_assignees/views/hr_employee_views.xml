<?xml version="1.0"?>

<odoo>
    <record id="hr_employee_view_form_inherit_so_assignees" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.so_assignees</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="unit_count" string="Units">
                    <field name="coordinator_assigned_ids" readonly="1">
                        <tree>
                            <field name="year"/>
                            <field name="month"/>
                            <field name="count"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="hr_employee_public_view_form_inherit_so_assignees" model="ir.ui.view">
        <field name="name">hr.employee.public.form.inherit.so_assignees</field>
        <field name="model">hr.employee.public</field>
        <field name="inherit_id" ref="hr.hr_employee_public_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="unit_count" string="Units" invisible="is_logged_in_user == False">
                    <field name="is_logged_in_user" invisible="1"/>
                    <field name="coordinator_assigned_ids" readonly="1">
                        <tree>
                            <field name="year"/>
                            <field name="month"/>
                            <field name="count"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
