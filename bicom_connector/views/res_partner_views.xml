<?xml version="1.0"?>
<odoo>

    <!-- Add call history action view to contact view -->
    <record id="view_partners_form_bicom_connector" model="ir.ui.view">
        <field name="name">view.res.partner.form.bicom_connector</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_call_history"
                        icon="fa-phone-square">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Call History</span>
                    </div>
                </button>
            </div>
            <xpath expr="//field[@name='function'][1]" position="after">
                <field name="phone_sanitized"/>
            </xpath>
        </field>
    </record>

</odoo>
