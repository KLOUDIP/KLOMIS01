<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_user_view_form_inherit_bicom_connector" model="ir.ui.view">
        <field name="name">res.user.view.form.inherit.bicom.connector</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <group name="messaging" position="after">
                <group>
                    <label for="uuid_token"/>
                    <div class="o_row">
                        <field name="uuid_token" readonly="1"/>
                        <button name="generate_uuid_token" type="object" string="Get Token" invisible="uuid_token != False"/>
                    </div>
                </group>
            </group>
        </field>
    </record>
</odoo>
