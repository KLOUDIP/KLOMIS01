<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            FIOS roles.

            Two groups under one privilege, in the Odoo 19 shape
            (ir.module.category -> res.groups.privilege -> res.groups):

              User          - the billing team. Sees the FIOS app but only the
                              Import Accounts menu, and the restricted version of
                              the contact FIOS tab (no identifiers, read-only
                              service tier, no device IMEI / phone).
              Administrator - implies User, plus every FIOS menu and the full
                              contact FIOS tab.

            base.group_system is given Administrator so existing system
            administrators keep everything they had before this change.
        -->

        <record id="module_category_fios" model="ir.module.category">
            <field name="name">FIOS</field>
            <field name="description">Access to the FIOS (Wialon) integration.</field>
            <field name="sequence">30</field>
        </record>

        <record id="res_groups_privilege_fios" model="res.groups.privilege">
            <field name="name">FIOS</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="module_category_fios"/>
        </record>

        <record id="group_fios_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_fios"/>
            <field name="comment">Billing-side FIOS access: the FIOS app with the Import
                Accounts menu only, and the contact FIOS tab without the platform
                identifiers or device IMEI / phone numbers.</field>
        </record>

        <record id="group_fios_administrator" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_fios"/>
            <field name="implied_ids" eval="[(4, ref('group_fios_user'))]"/>
            <field name="comment">Full FIOS access: every menu in the FIOS app and the
                complete contact FIOS tab, including the platform identifiers, an
                editable service tier and the device diagnostics.</field>
        </record>

        <!-- Keep system administrators whole: they held all of this before the
             groups existed. (4, ...) adds without disturbing other implications. -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_fios_administrator'))]"/>
        </record>

    </data>
</odoo>
