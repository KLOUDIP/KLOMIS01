<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_fios" model="ir.ui.view">
        <field name="name">product.template.form.fios</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="fios_tier_id"/>
                <field name="fios_service"/>
                <field name="fios_plan_code"/>
                <field name="is_fios_free_plan"/>
            </xpath>
        </field>
    </record>
</odoo>