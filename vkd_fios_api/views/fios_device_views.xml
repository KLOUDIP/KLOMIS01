<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Standalone list view for FIOS devices.

        The devices list embedded on the contact form is a one2many, and Odoo
        does not render the Export button on embedded x2many lists - only on
        list views opened through an action. The "Export Devices" button on the
        contact opens this action for the current customer, which gives the user
        the standard Odoo export dialog (XLSX / CSV) with Device / Plate and
        Status already loaded as the visible columns.
    -->
    <record id="view_fios_device_list" model="ir.ui.view">
        <field name="name">fios.device.list</field>
        <field name="model">fios.device</field>
        <field name="arch" type="xml">
            <list string="FIOS Devices" create="0" delete="0" edit="0"
                  default_order="device_active desc, name"
                  decoration-muted="not device_active">
                <field name="name" string="Device / Plate"/>
                <field name="device_status" string="Status" widget="badge"
                       decoration-success="device_status == 'activated'"
                       decoration-danger="device_status == 'deactivated'"/>
                <!-- Technical identifiers: hidden from the billing team. -->
                <field name="imei" string="IMEI" widget="char" class="text-nowrap"
                       optional="show"
                       groups="field_service_extension.group_fsm_tech_team,base.group_system"/>
                <field name="phone" string="Phone" widget="char" class="text-nowrap"
                       optional="show"
                       groups="field_service_extension.group_fsm_tech_team,base.group_system"/>
                <field name="partner_id" optional="hide"/>
                <field name="device_active" string="Activated"
                       widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_fios_device_search" model="ir.ui.view">
        <field name="name">fios.device.search</field>
        <field name="model">fios.device</field>
        <field name="arch" type="xml">
            <!-- NB: <group> here carries no `expand` / `string`. Odoo 19's
                 search-view schema rejects those attributes; the same bare
                 form is what vkd_trazet_api uses on this database. -->
            <search string="FIOS Devices">
                <field name="name"/>
                <field name="partner_id"/>
                <!-- imei is deliberately not searchable here: it is hidden from
                     the billing team, and a search field would let them probe
                     for it. -->
                <field name="imei"
                       groups="field_service_extension.group_fsm_tech_team,base.group_system"/>

                <separator/>
                <filter name="filter_activated" string="Activated"
                        domain="[('device_active', '=', True)]"/>
                <filter name="filter_deactivated" string="Deactivated"
                        domain="[('device_active', '=', False)]"/>

                <group>
                    <filter name="group_partner" string="Customer"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_status" string="Status"
                            context="{'group_by': 'device_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fios_device" model="ir.actions.act_window">
        <field name="name">FIOS Devices</field>
        <field name="res_model">fios.device</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_fios_device_search"/>
    </record>
</odoo>
