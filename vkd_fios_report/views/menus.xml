<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Reporting is open to all three FIOS roles: Billing Team, Tech Team and
        Administrator (Administrator implies the other two, so listing Billing
        Team and Tech Team covers it).

        vkd_fios_api shows the FIOS root menu to the Billing Team only. The Tech
        Team is added to it here so they can reach Reporting; every other FIOS
        menu keeps its own groups, so they still see nothing else in the app.
        menuitem `groups` are written with Command.link, so an upgrade of
        vkd_fios_api adds its group back without removing this one.
    -->
    <record id="vkd_fios_api.menu_fios_root" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('vkd_fios_api.group_fios_tech_team'))]"/>
    </record>

    <menuitem id="menu_fios_reporting" name="Reporting"
              parent="vkd_fios_api.menu_fios_root" sequence="50"
              groups="vkd_fios_api.group_fios_user,vkd_fios_api.group_fios_tech_team"/>

    <menuitem id="menu_fios_account_report" name="FIOS Accounts"
              parent="menu_fios_reporting" action="action_vkd_fios_account_report"
              sequence="10"
              groups="vkd_fios_api.group_fios_user,vkd_fios_api.group_fios_tech_team"/>

    <menuitem id="menu_fios_units_report" name="FIOS Units"
              parent="menu_fios_reporting" action="action_vkd_fios_units"
              sequence="20"
              groups="vkd_fios_api.group_fios_user,vkd_fios_api.group_fios_tech_team"/>
</odoo>
