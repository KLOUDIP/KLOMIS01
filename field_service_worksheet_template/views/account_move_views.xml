<?xml version="1.0"?>
<odoo>
    <record id="account_view_move_form" model="ir.ui.view">
        <field name="name">account.move.view.form.</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="worksheet_task_id" invisible="1" />
                <button
                    string="Project Task"
                    class="oe_stat_button"
                    name="action_view_project_task"
                    type="object"
                    icon="fa-life-ring"
                    invisible="worksheet_task_id == False"/>
            </xpath>
        </field>
    </record>
</odoo>