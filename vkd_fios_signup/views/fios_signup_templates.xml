<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="fios_signup_page" name="FIOS Sign Up">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="container py-5" style="max-width: 640px;">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4 p-md-5">
                            <h1 class="mb-1 h2">FIOS Registration</h1>
                            <p class="text-muted mb-4">Create a FIOS customer account.</p>

                            <div class="alert alert-danger" t-if="error">
                                <span t-out="error"/>
                            </div>

                            <form id="fios_signup_form" action="/fios-signup/submit" method="post">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="redirect" t-att-value="form_data.get('redirect')"/>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label" for="name">Name</label>
                                        <input type="text" class="form-control" id="name" name="name"
                                               required="required" t-att-value="form_data.get('name')"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" for="organizationName">Company name</label>
                                        <input type="text" class="form-control" id="organizationName"
                                               name="organizationName" required="required"
                                               t-att-value="form_data.get('organizationName')"/>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label" for="email">Email</label>
                                        <input type="email" class="form-control" id="email" name="email"
                                               required="required" autocapitalize="off" autocorrect="off"
                                               spellcheck="false" t-att-value="form_data.get('email')"/>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label" for="phone">Phone number</label>
                                        <input type="text" class="form-control" id="phone" name="phone"
                                               required="required" placeholder="+14155552671"
                                               t-att-value="form_data.get('phone')"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" for="password">Password</label>
                                        <input type="password" class="form-control" id="password" name="password"
                                               required="required" autocomplete="new-password"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" for="repeatPassword">Repeat password</label>
                                        <input type="password" class="form-control" id="repeatPassword"
                                               name="repeatPassword" required="required" autocomplete="new-password"/>
                                    </div>
                                    <div class="col-12">
                                        <small class="form-text text-muted">
                                            At least 8 characters, with an uppercase letter, a lowercase letter,
                                            a number and a special character (!@#$%^&amp;*-_), and different from your email.
                                        </small>
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-primary mt-4">Sign up</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="fios_signup_otp_page" name="FIOS Sign Up - Verify Email">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="container py-5" style="max-width: 480px;">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4 p-md-5">
                            <h1 class="mb-1 h2">Verify your email</h1>
                            <p class="text-muted mb-4">Enter the code we sent to confirm it's really you.</p>

                            <div class="alert alert-danger" t-if="error">
                                <span t-out="error"/>
                            </div>
                            <div class="alert alert-info" t-if="info">
                                <span t-out="info"/>
                            </div>
                            <div class="alert alert-warning" t-if="debug_code">
                                <strong>TEST MODE</strong> — email is not delivered here. Your code is
                                <code style="font-size:18px" t-out="debug_code"/>
                            </div>

                            <form id="fios_otp_form" action="/fios-signup/verify" method="post">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <label class="form-label" for="otp">Verification code</label>
                                <input type="text" class="form-control" id="otp" name="otp"
                                       required="required" inputmode="numeric" autocomplete="one-time-code"
                                       maxlength="6" placeholder="123456"/>
                                <button type="submit" class="btn btn-primary mt-4 w-100">Verify &amp; continue</button>
                            </form>

                            <form action="/fios-signup/resend" method="post" class="mt-3 text-center">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <button type="submit" class="btn btn-link p-0">Resend code</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>