<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- My Tasks: kanban action -->
    <record id="project_task_action_fsm_technicians" model="ir.actions.act_window">
        <field name="name">My Tasks</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">kanban,calendar,tree,form,activity</field>
        <field name="search_view_id" ref="industry_fsm.project_task_view_search_fsm"/>
        <field name="domain">[('is_fsm', '=', True), ('project_id', '!=', False), ('display_in_project', '=', True), ('user_ids', '=', uid)]</field>
        <field name="context">{'fsm_mode': True,'search_default_my_tasks': True,'search_default_planned_future': True,'search_default_planned_today': True,'default_user_ids': [(4, uid)],'default_scale': 'day'}
        </field>
        <field name="view_ids" eval="[
        (5, 0, 0),
        (0, 0, {'view_mode': 'kanban', 'view_id': ref('industry_fsm.project_task_action_fsm_no_quick_create')}),
        (0, 0, {'view_mode': 'tree'}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('field_service_extension.view_task_form_technician')})]"/>
        <field name="help" type="html">
            <p class='o_view_nocontent_smiling_face'>No tasks found. Let's create one!</p>
            <p>Find here your tasks planned for the following days.</p>
        </field>
    </record>

    <menuitem id="fsm_menu_tasks_kanban_technician"
              name="Technician Tasks"
              action="field_service_extension.project_task_action_fsm_technicians"
              sequence="10"
              parent="industry_fsm.fsm_tasks_menu"
              groups="field_service_extension.group_fsm_technician"/>

    <record model='ir.ui.menu' id='industry_fsm.fsm_menu_tasks_kanban'>
        <field name="groups_id" eval="[(4,ref('field_service_worksheet_template.group_coordinator_fsm')), (4,ref('field_service_extension.group_fsm_tech_team')), (4,ref('field_service_extension.group_fsm_basic_user')), (3,ref('industry_fsm.group_fsm_user'))]"/>
    </record>

    <record model='ir.ui.menu' id='industry_fsm.fsm_menu_tasks_map'>
        <field name="groups_id" eval="[(4,ref('field_service_extension.group_fsm_basic_user'))]"/>
    </record>

</odoo>