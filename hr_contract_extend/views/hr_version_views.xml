<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_contract_view_form" model="ir.ui.view">
        <field name="name">hr.version.view.form.inherit.hr.contract.extend</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr.hr_contract_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='contract_type_id']" position="before">
                <field name="deduction_basic"/>
                <field name="deduction_reimb"/>
                <field name="deduction_unpaid_leave"/>
                <field name="phone_bill_excess"/>
                <field name="reimb_exp"/>
                <field name="reimb_trav"/>
                <field name="br_allowance_one"/>
                <field name="br_allowance_two"/>
                <field name="paye"/>
            </xpath>
        </field>
    </record>

    <record id="hr_version_list_view" model="ir.ui.view">
        <field name="name">hr.version.list.show.view.button</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr.hr_version_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_open_version_form_view']"
                   position="attributes">
                <attribute name="groups">hr_payroll.group_hr_payroll_manager</attribute>
            </xpath>
        </field>
    </record>
</odoo>
