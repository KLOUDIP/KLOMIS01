<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="trazet_signup_api_url_param" model="ir.config_parameter">
            <field name="key">vkd_trazet_signup.api_url</field>
<!--            dev; switch to the production auth-API host when available -->
            <field name="value">https://dev.api.trazet.com/api</field>
        </record>
        <record id="trazet_signup_redirect_url_param" model="ir.config_parameter">
            <field name="key">vkd_trazet_signup.redirect_url</field>
            <field name="value">https://dev.trazet.com/login</field>
        </record>
        <record id="trazet_signup_domain_param" model="ir.config_parameter">
            <field name="key">vkd_trazet_signup.domain</field>
            <field name="value">dev.trazet.com</field>
        </record>
    </data>
</odoo>