<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="loyalty_report" inherit_id="loyalty.loyalty_report">
        <div class="page" position="replace">
            <div class="page">
                <!-- Odoo 19 variable mapping -->
                <t t-set="reward"
                   t-value="o.program_id.reward_ids[0] if o.program_id.reward_ids else o.env['loyalty.reward']"/>
                <t t-set="rule" t-value="o.program_id.rule_ids[0] if o.program_id.rule_ids else o.env['loyalty.rule']"/>

                <div class="row text-center">
                    <div class="o_offer col-lg-12">
                        <h4>Here is your Deposit Voucher from
                            <t t-out="o.program_id.company_id.name"/>
                        </h4>
                        <t t-if="o.invoice_partner_id">
                            <h4>Issued to:
                                <t t-out="o.invoice_partner_id.name"/>
                            </h4>
                        </t>
                        <t t-else="">
                            <h4>Issued to:
                                <t t-out="o.partner_id.name"/>
                            </h4>
                        </t>

                        <t t-if="reward.reward_type == 'discount'">
                            <t t-set="trans_text">off %s</t>
                            <t t-set="text" t-value="trans_text % text"/>

                            <h1 t-if="reward.discount_mode != 'percent'"
                                style="font-size: 55px; color: #875A7B">
                                <strong>
                                    <span t-out="reward.discount"
                                          t-options='{"widget": "monetary", "display_currency": reward.currency_id}'/>
                                </strong>
                            </h1>
                            <h1 t-else=""
                                style="font-size: 55px; color: #875A7B">
                                <t t-if="o.coupon_product_id">
                                    <strong>
                                        <span t-field="o.coupon_product_id.name"/>
                                    </strong>
                                </t>
                                <t t-else="">
                                    <strong>
                                        <span t-out="reward.discount"/>
                                        %
                                    </strong>
                                </t>
                            </h1>
                            <t t-if="reward.discount_applicability == 'specific'">
                                <t t-if="len(reward.discount_product_ids) &gt; 1">
                                    <t t-set="text">off on some products*</t>
                                    <t t-set="display_specific_products" t-value="True"/>
                                </t>
                                <t t-else="">
                                    <t t-set="trans_text">off on %s</t>
                                    <t t-set="text"
                                       t-value="trans_text % reward.discount_product_ids.name"/>
                                </t>
                            </t>
                            <t t-if="reward.discount_applicability == 'cheapest'">
                                <t t-set="text">off on the cheapest product</t>
                            </t>
                        </t>

                        <t t-if="reward.reward_type == 'product'">
                            <strong style="font-size: 55px; color: #875A7B">
                                <t t-out="'get %s free %s' % (reward.reward_product_qty, reward.reward_product_id.name)"/>
                            </strong>
                        </t>

                        <t t-if="reward.reward_type == 'shipping'">
                            <strong style="font-size: 55px; color: #875A7B">get free shipping</strong>
                        </t>

                        <h1 class="font-weight-bold" style="font-size: 34px" t-out="text"/>
                        <br/>

                        <h4 t-if="o.expiration_date">
                            Use this promo code before
                            <span t-field="o.expiration_date" t-options='{"format": "yyyy-MM-d"}'/>
                        </h4>

                        <h2 class="mt32">
                            <strong class="bg-light" t-out="o.code" style="padding: 20px 10px;"/>
                        </h2>

                        <h4 t-if="rule.minimum_qty &gt; 1">
                            <span>Minimum purchase of</span>
                            <strong t-out="rule.minimum_qty"/>
                            <span>products</span>
                        </h4>

                        <h4 t-if="rule.minimum_amount">
                            <span>Valid for purchase above</span>
                            <strong t-out="rule.minimum_amount"
                                    t-options="{'widget': 'monetary', 'display_currency': rule.currency_id}"/>
                        </h4>

                        <p t-if="display_specific_products">
                            <small>
                                *Valid for following products:
                                <t t-out="', '.join(reward.discount_product_ids.mapped('name'))"/>
                            </small>
                        </p>

                        <br/>
                        <img alt="Barcode" t-att-src="'/report/barcode/Code128/%s' % o.code"/>
                        <br/>
                        <br/>

                        <h4>Thank you,</h4>
                        <br/>
                        <div class="mt32">
                            <div class="text-center">
                                <img alt="Logo" t-att-src="'/logo?company=%d' % (o.program_id.company_id)"
                                     t-att-alt="'%s' % (o.program_id.company_id.name)"
                                     style="border:0px solid transparent; height: 50px; width: 200px;" height="110"/>
                            </div>
                        </div>

                        <div>
                            <div class="text-center d-inline-block">
                                <span t-field="o.program_id.company_id.partner_id"
                                      t-options='{"widget": "contact", "fields": ["address", "email"], "no_marker": True}'/>
                            </div>
                        </div>
                        <div style='margin-top:2%; color: #875A7B'>
                            <b>Important: Please retain this safely for Deposit Refunds.</b>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </template>
</odoo>