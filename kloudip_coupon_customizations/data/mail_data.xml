<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="coupon_created_message">
        <p>
            <t t-if="partner_generate_email_for_coupons">
                <t>Coupons created as following and Emails sent to the customer regarding created coupons:</t>
                <br/>
            </t>
            <t t-else="">
                <t>Following coupons created for the invoice customer:</t>
            </t>
            <t t-foreach="data" t-as="o">
                <t t-out="o['product'].name"/>
                -
                <t t-foreach="o['coupons']" t-as="x">
                    <a href="#" t-att-data-oe-model="x._name" t-att-data-oe-id="x.id">
                        <t t-out="x.display_name"/>
                    </a>
                    <!-- Fix: Compare the ID directly instead of using list slicing -->
                    <span t-if="x != o['coupons'][-1]">,</span>
                </t>
                <br/>
            </t>
        </p>
    </template>
</odoo>